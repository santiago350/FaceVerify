<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="⬡"
            android:textSize="68sp"
            android:textColor="#38BDF8"
            android:background="#14243B"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FACEVERIFY"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.10"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/txtWelcomeUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido, usuario!"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Qué deseas hacer?"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnVerifyIdentity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="VERIFICAR IDENTIDAD"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ELIMINAR CUENTA"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#B91C1C"
            android:layout_marginTop="14dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CERRAR SESIÓN"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#17243A"
            android:layout_marginTop="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEGURIDAD BIOMÉTRICA"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:layout_marginTop="32dp"/>

    </LinearLayout>
</ScrollView>
