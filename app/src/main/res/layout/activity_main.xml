<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080D18"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22080D18" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="14dp"
        android:background="#CC080D18">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬡ FACEVERIFY"
                android:textColor="#38BDF8"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASO 1 DE 5"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressLiveness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:max="5"
            android:progress="0"
            android:progressTint="#38BDF8"
            android:progressBackgroundTint="#334155" />
    </LinearLayout>

    <View
        android:id="@+id/faceGuide"
        android:layout_width="260dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:translationY="-20dp"
        android:background="@drawable/face_oval_guide" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp"
        android:background="#E6080D18">

        <TextView
            android:id="@+id/txtCameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cámara preparada"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtChallengeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRUEBA DE VIDA"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/txtChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona iniciar para comenzar"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:minHeight="58dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnCompare"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="INICIAR VERIFICACIÓN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:backgroundTint="#0284C7"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" "
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="8dp" />

        <!-- BOTONES POST-VERIFICACIÓN -->
        <LinearLayout
            android:id="@+id/resultButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnBackMenu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="VOLVER AL MENÚ ANTERIOR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#334155" />

            <Button
                android:id="@+id/btnRestartVerification"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="INICIAR VERIFICACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#0284C7" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
